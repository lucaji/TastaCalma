    "Keyboard unlocked: another app enabled Secure Keyboard Entry. Stop cleaning before continuing." : {
      "comment" : "Announcement when the keyboard lock is stopped because another app has enabled Secure Keyboard Entry.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tastatur entsperrt: Eine andere App hat die sichere Tastatureingabe aktiviert. Beende die Reinigung, bevor du fortfährst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teclado desbloqueado: otra app ha activado la entrada segura mediante teclado. Deja de limpiar antes de continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Clavier déverrouillé : une autre app a activé la saisie sécurisée au clavier. Arrêtez le nettoyage avant de continuer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "किसी दूसरे ऐप ने Secure Keyboard Entry चालू कर दिया, इसलिए कीबोर्ड अनलॉक कर दिया गया। जारी रखने से पहले सफ़ाई रोकें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tastiera sbloccata: un’altra app ha attivato l’inserimento sicuro da tastiera. Interrompi la pulizia prima di continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "キーボードのロックを解除しました: 別のアプリがセキュアキーボード入力を有効にしました。続ける前に清掃を中止してください。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teclado desbloqueado: outra aplicação ativou a Entrada Segura pelo Teclado. Pare a limpeza antes de continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Клавиатура разблокирована: другое приложение включило защищённый ввод с клавиатуры. Остановите очистку, прежде чем продолжить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Klavye kilidi açıldı: Başka bir uygulama Güvenli Klavye Girişi’ni etkinleştirdi. Devam etmeden önce temizliği bırakın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Клавіатуру розблоковано: інша програма ввімкнула захищене введення з клавіатури. Перш ніж продовжити, припиніть очищення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "键盘已解锁：另一个App启用了安全键盘输入。请先停止清洁，再继续操作。"
          }
        },
        "zh-Hant" : {
