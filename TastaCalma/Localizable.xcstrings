    "Avoid the power / Touch ID key. It cannot be locked." : {
      "comment" : "A warning displayed in the footer of the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spare die Ein-/Ausschalttaste bzw. Touch ID-Taste aus. Sie kann nicht gesperrt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Evita la tecla de encendido (Touch ID). No se puede bloquear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Évitez la touche d’alimentation/Touch ID. Elle ne peut pas être verrouillée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "पावर / Touch ID-की को न दबाएँ। इसे लॉक नहीं किया जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Evita il tasto di accensione/Touch ID: non può essere bloccato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "電源/Touch IDキーは避けてください。このキーはロックできません。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Evite a tecla de alimentação / Touch ID. Não pode ser bloqueada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не нажимайте клавишу питания / Touch ID. Её нельзя заблокировать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Güç / Touch ID tuşunu kullanmayın. Bu tuş kilitlenemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не натискайте клавішу живлення / Touch ID. Її не можна заблокувати."
