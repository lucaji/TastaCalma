        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“システム設定”＞“プライバシーとセキュリティ”＞“アクセシビリティ”で%@を有効にしてから、ここに戻ってください。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
