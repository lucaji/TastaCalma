    "Accessibility access is enabled. Choose a duration and start the timer when you’re ready to clean." : {
      "comment" : "Accessibility setup sheet. TastaCalma.app is the installed filename and must remain unchanged.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Zugriff auf Bedienungshilfen ist aktiviert. Wähle eine Dauer und starte den Timer, wenn du mit dem Reinigen beginnen möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El acceso a Accesibilidad está activado. Elige una duración e inicia el temporizador cuando quieras empezar a limpiar."
          }
        },
        "fr" : {
          "stringUnit" : {
