    "Allow Accessibility access so the timer can temporarily block your keys. Key presses are never recorded." : {
      "comment" : "Accessibility setup sheet. TastaCalma.app is the installed filename and must remain unchanged.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Erlaube den Zugriff auf Bedienungshilfen, damit der Timer deine Tasten vorübergehend sperren kann. Tastendrücke werden niemals aufgezeichnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permite el acceso a Accesibilidad para que el temporizador pueda bloquear las teclas temporalmente. Las pulsaciones nunca se registran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Autorisez l’accès à l’accessibilité pour que le minuteur puisse bloquer temporairement vos touches. Les frappes ne sont jamais enregistrées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ऐक्सेसिबिलिटी की अनुमति दें ताकि टाइमर आपकी कुंजियों को कुछ समय के लिए रोक सके। दबाई गई कुंजियाँ कभी रिकॉर्ड नहीं की जातीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Consenti l’accesso ad Accessibilità per permettere al timer di bloccare temporaneamente i tasti. I tasti premuti non vengono mai registrati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "タイマーでキー入力を一時的に無効にするため、アクセシビリティへのアクセスを許可してください。キー入力が記録されることはありません。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permita o acesso à acessibilidade para que o temporizador possa bloquear temporariamente as teclas. As teclas premidas nunca são registadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Разрешите универсальный доступ, чтобы таймер мог временно блокировать клавиши. Нажатия клавиш никогда не записываются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zamanlayıcının tuşlarınızı geçici olarak engelleyebilmesi için Erişilebilirlik izni verin. Tuş vuruşları hiçbir zaman kaydedilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Надайте універсальний доступ, щоб таймер міг тимчасово блокувати клавіші. Натискання клавіш ніколи не записуються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请允许辅助功能访问，以便计时器暂时屏蔽按键。按键内容绝不会被记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "請允許輔助使用權限，讓計時器暫時阻擋按鍵輸入。按鍵內容絕不會被記錄。"
          }
        }
      }
    },
    "Already listed? Just enable its switch." : {
