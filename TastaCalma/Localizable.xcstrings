    "Secure Keyboard Entry is active. Close password fields or turn it off in the app using it, then try again." : {
      "comment" : "Warning message when Secure Keyboard Entry is active.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die sichere Tastatureingabe ist aktiv. Schließe Passwortfelder oder deaktiviere sie in der App, die sie verwendet, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La entrada segura mediante teclado está activa. Cierra los campos de contraseña o desactívala en la app que la está usando y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La saisie sécurisée au clavier est active. Fermez les champs de mot de passe ou désactivez-la dans l’app qui l’utilise, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Secure Keyboard Entry चालू है। पासवर्ड फ़ील्ड बंद करें या इसका इस्तेमाल करने वाले ऐप में इसे बंद करें, फिर से कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’inserimento sicuro da tastiera è attivo. Chiudi i campi password o disattivalo nell’app che lo utilizza, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "セキュアキーボード入力が有効です。パスワード入力欄を閉じるか、使用中のアプリで無効にしてから、やり直してみてください。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A Entrada Segura pelo Teclado está ativa. Feche os campos de palavra‑passe ou desative-a na aplicação que a está a utilizar e, em seguida, tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Включён защищённый ввод с клавиатуры. Закройте поля пароля или отключите эту функцию в использующем её приложении, затем повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Güvenli Klavye Girişi etkin. Parola alanlarını kapatın veya bu özelliği kullanan uygulamada devre dışı bırakın, ardından yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Захищене введення з клавіатури активне. Закрийте поля паролів або вимкніть цю функцію в програмі, яка її використовує, а потім спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "安全键盘输入已启用。请关闭密码输入框，或在使用该功能的App中将其关闭，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "「安全鍵盤輸入」已啟用。請關閉密碼欄位，或在使用此功能的App中將其關閉，然後再試一次。"
          }
        }
      }
    },
