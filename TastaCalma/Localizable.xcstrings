    "Automatically follows your Mac’s light or dark appearance." : {
      "comment" : "A description of each theme.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Folgt automatisch dem hellen oder dunklen Erscheinungsbild deines Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sigue automáticamente la apariencia clara u oscura del Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suit automatiquement l’apparence claire ou sombre de votre Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
