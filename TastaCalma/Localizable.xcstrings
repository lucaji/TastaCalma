            "value" : "ऐक्सेसिबिलिटी की अनुमति मिल गई है। अवधि चुनें और जब सफ़ाई शुरू करनी हो, टाइमर चालू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "L’accesso ad Accessibilità è attivo. Scegli una durata e avvia il timer quando vuoi iniziare a pulire."
