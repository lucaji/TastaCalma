{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ on GitHub." : {
      "comment" : "A link to the TastaCalma project on GitHub.",
      "isCommentAutoGenerated" : true
    },
    "%@ Switches to %@ appearance. Your choice is saved." : {
      "comment" : "A description of the theme, including the name of the next theme.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ Wechselt zum Erscheinungsbild „%2$@“. Deine Auswahl wird gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Switches to %2$@ appearance. Your choice is saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ Cambia a la apariencia %2$@. Tu elección se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ Passe à l’apparence %2$@. Votre choix est enregistré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@ अपीयरेंस पर स्विच करता है। आपकी पसंद सेव हो जाती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ Passa all’aspetto %2$@. La scelta viene salvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@の外観に切り替えます。選択内容は保存されます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ Muda para o aspeto %2$@. A escolha fica guardada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ Переключает оформление на «%2$@». Ваш выбор сохранён."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ %2$@ görünümüne geçer. Seçiminiz kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ Перемикає на оформлення «%2$@». Вибір збережено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 切换到%2$@外观。你的选择会被保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ 切換至%2$@外觀。你的選擇將會儲存。"
          }
        }
      }
    },
    "%@ temporarily pauses keyboard input so you can wipe your keys clean.\nYour keyboard returns automatically when the timer ends." : {
      "comment" : "A description of the app's purpose.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ unterbricht vorübergehend die Tastatureingabe, damit du deine Tasten sauber wischen kannst.\nDeine Tastatur wird automatisch wieder aktiviert, wenn der Timer abgelaufen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pausa temporalmente la entrada del teclado para que puedas limpiar bien las teclas.\nEl teclado vuelve a estar disponible automáticamente cuando termina el temporizador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ met temporairement en pause la saisie au clavier afin que vous puissiez nettoyer vos touches.\nVotre clavier est automatiquement réactivé à la fin du minuteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ कीबोर्ड इनपुट को अस्थायी रूप से रोकता है, ताकि आप अपनी कीज़ को पोंछकर साफ़ कर सकें।\nटाइमर खत्म होने पर कीबोर्ड इनपुट अपने आप फिर शुरू हो जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ disabilita temporaneamente la tastiera del tuo Mac, cosicché possa essere pulita con un panno.\nLa tastiera ritorna attiva quando il tempo scade."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を使うと、キーをきれいに拭けるようにキーボード入力が一時停止します。\nタイマーが終了すると、キーボード入力は自動的に再開します。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pausa temporariamente a entrada do teclado para que possa limpar bem as teclas.\nO teclado é reativado automaticamente quando o temporizador terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение %@ временно приостанавливает ввод с клавиатуры, чтобы можно было протереть клавиши.\nВвод возобновится автоматически после завершения таймера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tuşlarınızı silerek temizleyebilmeniz için klavye girişini geçici olarak duraklatır.\nZamanlayıcı sona erdiğinde klavyeniz otomatik olarak yeniden etkinleşir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ тимчасово призупиняє введення з клавіатури, щоб можна було протерти клавіші.\nВведення відновиться автоматично після завершення таймера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@会暂时暂停键盘输入，方便你将按键擦拭干净。\n计时结束后，键盘会自动恢复使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%[tt]@會暫停鍵盤輸入，方便你將按鍵擦拭乾淨。\n計時結束後，鍵盤會自動恢復使用。"
          }
        }
      }
    },
