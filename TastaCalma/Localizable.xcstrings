    "Wipe gently. Your keyboard will be back in a moment." : {
      "comment" : "A message displayed when the user is locked.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wische vorsichtig. Deine Tastatur ist gleich wieder verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Limpia con suavidad. El teclado volverá a estar disponible en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nettoyez délicatement. Votre clavier sera de nouveau disponible dans un instant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "धीरे से साफ़ करें। आपका कीबोर्ड बस कुछ ही पलों में फिर तैयार हो जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pulisci delicatamente. Tra un attimo la tastiera sarà di nuovo disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "やさしく拭いてください。まもなくキーボードが使えるようになります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Limpe com cuidado. O teclado estará novamente disponível dentro de momentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Аккуратно протрите клавиатуру. Она снова заработает через мгновение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nazikçe silin. Klavyeniz birazdan yeniden kullanıma hazır olacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Обережно протріть. Клавіатура запрацює за мить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "轻轻擦拭。键盘很快就能恢复使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "輕輕擦拭，鍵盤很快就能恢復使用。"
          }
        }
      }
    },
