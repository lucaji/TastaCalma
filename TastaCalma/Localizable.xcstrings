    "macOS did not enable the keyboard lock. Please check Accessibility access." : {
      "comment" : "Error message when the keyboard lock is not enabled by macOS.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS hat die Tastatursperre nicht aktiviert. Überprüfe den Zugriff auf die Bedienungshilfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS no ha activado el bloqueo del teclado. Comprueba el acceso a Accesibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS n’a pas activé le verrouillage du clavier. Vérifiez l’accès à l’accessibilité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS ने कीबोर्ड लॉक चालू नहीं किया। कृपया Accessibility एक्सेस जाँचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS non ha attivato il blocco della tastiera. Verifica l’accesso ad Accessibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOSでキーボードのロックを有効にできませんでした。アクセシビリティへのアクセスを確認してください。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O macOS não ativou o bloqueio do teclado. Verifique o acesso à Acessibilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Системе macOS не удалось включить блокировку клавиатуры. Проверьте доступ к Универсальному доступу."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS klavye kilidini etkinleştirmedi. Lütfen Erişilebilirlik erişimini denetleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS не ввімкнула блокування клавіатури. Перевірте доступ до Універсального доступу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS未能启用键盘锁定。请检查“辅助功能”访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS未能啟用鍵盤鎖定。請檢查「輔助使用」權限。"
          }
        }
      }
    },
    "macOS interrupted the keyboard lock. Stop cleaning and start a new timer when ready." : {
      "comment" : "A message that is displayed when the user stops the keyboard lock while it is running, but macOS has interrupted the keyboard lock.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS hat die Tastatursperre unterbrochen. Beende die Reinigung und starte einen neuen Timer, wenn du bereit bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS ha interrumpido el bloqueo del teclado. Deja de limpiar e inicia un nuevo temporizador cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS a interrompu le verrouillage du clavier. Arrêtez le nettoyage et démarrez un nouveau minuteur quand vous le souhaitez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS ने कीबोर्ड लॉक रोक दिया। सफ़ाई रोकें और तैयार होने पर नया टाइमर शुरू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS ha interrotto il blocco della tastiera. Interrompi la pulizia e avvia un nuovo timer quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOSによってキーボードのロックが中断されました。清掃を中止し、準備ができたら新しいタイマーを開始してください。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O macOS interrompeu o bloqueio do teclado. Pare a limpeza e inicie um novo temporizador quando estiver tudo pronto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Система macOS прервала блокировку клавиатуры. Остановите очистку и запустите новый таймер, когда будете готовы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS klavye kilidini kesintiye uğrattı. Temizliği bırakın ve hazır olduğunuzda yeni bir zamanlayıcı başlatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS перервала блокування клавіатури. Припиніть очищення та, коли будете готові, запустіть новий таймер."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS中断了键盘锁定。请停止清洁，准备好后启动新的计时器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS中斷了鍵盤鎖定。請停止清潔，準備好後再啟動新的計時器。"
          }
        }
      }
    },
