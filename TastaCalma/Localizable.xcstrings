    "Keyboard locking could not start. Check %@’s Accessibility access and reopen the app if you just enabled it." : {
      "comment" : "A description of an error that might occur when starting the keyboard lock.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Tastatursperre konnte nicht gestartet werden. Überprüfe den Zugriff von %@ auf die Bedienungshilfen und öffne die App erneut, falls du ihn gerade aktiviert hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No se ha podido iniciar el bloqueo del teclado. Comprueba el acceso de %@ a Accesibilidad y vuelve a abrir la app si acabas de activarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le verrouillage du clavier n’a pas pu démarrer. Vérifiez l’accès de %@ à l’accessibilité et rouvrez l’app si vous venez de l’activer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "कीबोर्ड लॉक करना शुरू नहीं हो सका। %@ का Accessibility एक्सेस जाँचें और अगर आपने इसे अभी-अभी चालू किया है, तो ऐप को फिर से खोलें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Impossibile avviare il blocco della tastiera. Verifica che %@ abbia accesso ad Accessibilità e, se l’hai appena abilitato, riapri l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "キーボードのロックを開始できませんでした。%@のアクセシビリティへのアクセスを確認してください。アクセスを有効にしたばかりの場合は、アプリを開き直してください。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Não foi possível iniciar o bloqueio do teclado. Verifique o acesso de %@ à Acessibilidade e volte a abrir a aplicação caso o tenha acabado de ativar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не удалось начать блокировку клавиатуры. Проверьте доступ приложения %@ к Универсальному доступу и снова откройте приложение, если доступ был предоставлен только что."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Klavye kilitleme başlatılamadı. %@ için Erişilebilirlik erişimini denetleyin ve erişimi yeni etkinleştirdiyseniz uygulamayı yeniden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Не вдалося розпочати блокування клавіатури. Перевірте доступ програми %@ до Універсального доступу й повторно відкрийте програму, якщо його щойно ввімкнено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法启动键盘锁定。请检查%@的“辅助功能”访问权限；如果你刚刚启用了该权限，请重新打开App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無法開始鎖定鍵盤。請檢查%[tt]@的「輔助使用」權限；如果你剛啟用此權限，請重新開啟App。"
          }
        }
      }
    },
