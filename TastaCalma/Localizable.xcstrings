    "Enable %@ in System Settings → Privacy & Security → Accessibility, then return here." : {
      "comment" : "A message that instructs the user to enable Accessibility access in System Settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aktiviere %@ in Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen und kehre dann hierher zurück."
          }
        },
        "es" : {
          "stringUnit" : {
